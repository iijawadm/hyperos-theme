[Icon Theme]
Name=HyperOS
Comment=HyperOS-inspired Freedesktop Linux icon theme converted from Android HyperOS assets and original artwork.
Inherits=Adwaita,hicolor
Example=folder
FollowsColorScheme=true

Directories=scalable/apps,scalable/devices,scalable/mimes,scalable/places,symbolic/actions,symbolic/apps,symbolic/categories,symbolic/devices,symbolic/emblems,symbolic/mimes,symbolic/places,16x16/actions,16x16/animations,16x16/apps,16x16/devices,16x16/emblems,16x16/mimes,16x16/places,16x16/status,22x22/actions,22x22/animations,22x22/devices,22x22/emblems,22x22/mimes,22x22/places,24x24/actions,24x24/animations,24x24/apps,24x24/devices,24x24/emblems,24x24/places,24x24/status,32x32/actions,32x32/apps,32x32/categories,32x32/devices,32x32/status,48x48/apps,48x48/devices,48x48/status,64x64/apps,64x64/devices,64x64/status,96x96/apps,96x96/devices,128x128/apps,128x128/devices,256x256/apps,256x256/devices

