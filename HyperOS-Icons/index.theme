[Icon Theme]
Name=HyperOS
Comment=HyperOS-inspired Freedesktop Linux icon theme converted from Android HyperOS assets and original artwork.
Inherits=Adwaita,hicolor
Example=folder
FollowsColorScheme=true

Directories=16x16/apps,16x16/devices,16x16/places,16x16/status,24x24/apps,24x24/devices,24x24/places,24x24/status,32x32/apps,32x32/devices,32x32/places,32x32/status,48x48/apps,48x48/devices,48x48/places,48x48/status,64x64/apps,64x64/devices,64x64/places,64x64/status,96x96/apps,96x96/devices,96x96/places,128x128/apps,128x128/devices,128x128/places,256x256/apps,256x256/devices,256x256/places

